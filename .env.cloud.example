# TEMPLATE ONLY. Set real secrets in Vercel's production environment.
# Do not connect preview deployments to the production database.
CLOUD_MODE=1
APP_ORIGIN=https://YOUR-PROJECT.vercel.app
# Hackathon: no visible login. ACCESS_PASSWORD remains a server-only signing secret.
PUBLIC_DEMO=1
ACCESS_USER=demo
ACCESS_PASSWORD=
# Supabase Connect -> Session pooler (5432); URL-encode password characters.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER-HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket; limit each uploaded object to 40 MiB.
SUPABASE_BUCKET=documents
# Existing paid model; hosting being free does not make these requests free.
ANTHROPIC_API_KEY=
# Speed: 8 forms read at once. Only the first page writes the prompt cache; the rest start
# when it begins streaming, so concurrency no longer multiplies the prompt cost (22/10/2026).
MAX_PARALLEL_CALLS=8
MAX_PAGES_PER_BATCH=30
MAX_FILES_PER_BATCH=25
MAX_UPLOAD_BYTES=41943040
# Opus 5.5 at medium effort measured ~4.7 US cents per form: 30 forms ~ $1.5.
MAX_COST_PER_BATCH_USD=3
PROMPT_CACHE_TTL=1h
# This cap is checked between calls, not a guaranteed billing limit.
PORT=80
