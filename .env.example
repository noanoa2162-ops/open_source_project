# העתיקו לקובץ בשם .env ומלאו שם את הערכים. אין לכתוב כאן מפתחות.
# .env מוחרג ב-.gitignore.

# ---- מפתחות: שני השופטים ----
# Google — מפתח מפרויקט עם חיוב פעיל (בשכבה החינמית: 20 בקשות ביום,
# ו-Google רשאית להשתמש בתוכן).
GEMINI_API_KEY=
# שופט B: Claude (ברירת מחדל) — מפתח מ-console.anthropic.com
ANTHROPIC_API_KEY=
# נדרש רק אם JUDGE_B_MODEL הוא מודל gpt-*
OPENAI_API_KEY=

# ---- השופטים ----
# שני מודלים זולים מחברות שונות. ערך מוצג רק כששניהם מסכימים.
# נבחרו אחרי השוואה על 3 עמודים אמיתיים (14/10/2026). ~0.9 סנט לטופס יחד.
# gemini-2.5-flash חסום לחשבונות חדשים; gpt-4o-mini המציא שמות ובלבל מספרים.
JUDGE_A_MODEL=gemini-3.8-flash
# שופט B נבחר לפי שם המודל: claude-* → Anthropic, gpt-* → OpenAI. החלפה = שורה אחת.
# 15/10/2026: claude-sonnet-5-5 קרא את הת"ז שבה gpt-5.4-mini החזיר "לא קיים".
JUDGE_B_MODEL=claude-sonnet-5-5
# עומק "החשיבה" של Claude: low | medium | high. גבוה יותר = יקר ואיטי יותר.
JUDGE_B_EFFORT=low

# GPT: 1 = עמוד שלם (ברירת מחדל ל-gpt-5.4 ומעלה, שקוראים ברזולוציה מקורית)
#      4 = ארבעה רבעים (ברירת מחדל ל-gpt-4o*, שמקטין כל תמונה ל-768px)
# GPT_IMAGE_SPLIT=1

# "חשיבה" של Gemini — כבויה (0). העתקת טקסט לא צריכה אותה, והיא מחויבת כפלט יקר.
GEMINI_THINKING_BUDGET=0

# ---- "דיו מודגש" ----
# לכל עמוד נשלחת גם גרסה בלי מרקרים, שבה כתב היד שחור — עוזר כשמרקר טורקיז
# עובר על עט כחול. 1 = פעיל (~+1 סנט לטופס), 0 = כבוי.
ENHANCE_INK=1

# ---- תקציב ----
# העלאה שתעבור את הסכום תיעצר לפני הקריאה הבאה, עם הודעה ברורה
MAX_COST_PER_BATCH_USD=1.00

# ---- איכות קלט ----
# תמונה שהצד הארוך שלה קצר מזה — אזהרת רזולוציה נמוכה (צילום מסך)
MIN_IMAGE_LONG_SIDE=1500
PAGE_RENDER_DPI=300

# ---- היקף ----
MAX_PAGES_PER_BATCH=30
MAX_FILES_PER_BATCH=25
MAX_PARALLEL_CALLS=4
MAX_UPLOAD_BYTES=41943040


