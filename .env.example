# העתיקו לקובץ בשם .env ומלאו שם את הערכים. אין לכתוב כאן מפתחות.
# .env מוחרג ב-.gitignore.
# כל הגדרה שלא כתובה ב-.env מקבלת את ברירת המחדל שמופיעה כאן.

# ---- מפתחות ----
# Claude — הקורא הראשי. מפתח מ-console.anthropic.com
ANTHROPIC_API_KEY=
# נדרש רק אם מפעילים את Gemini כשופט שני
GEMINI_API_KEY=
# נדרש רק אם אחד הקוראים הוא מודל gpt-*
OPENAI_API_KEY=

# ---- הקורא ----
# מאז 15/10/2026: קורא אחד חזק — Claude Opus 5.5 בחשיבה עמוקה. כל טופס נקרא לבד.
# מה שהוא לא בטוח בו — כתום. הבדיקות המקומיות (ת"ז, תאריכים, גורם שולח) רצות תמיד.
JUDGE_A_MODEL=claude-opus-5-5
# עומק החשיבה של Claude: low | medium | high | xhigh | max.
# ב-Opus 5.5 החשיבה תמיד פועלת; זה קובע כמה עמוק. עמוק יותר = יקר ואיטי יותר.
JUDGE_EFFORT=high

# ---- שופט שני (כבוי) ----
# ריק = קורא אחד. כדי לחזור לשני שופטים שמשווים זה לזה — שורה אחת, למשל:
# JUDGE_B_MODEL=gemini-3.8-flash
# המתאם נבחר לפי שם המודל: claude-* → Anthropic, gemini-* → Google, gpt-* → OpenAI.
JUDGE_B_MODEL=

# GPT: 1 = עמוד שלם (ברירת מחדל ל-gpt-5.4 ומעלה, שקוראים ברזולוציה מקורית)
#      4 = ארבעה רבעים (ברירת מחדל ל-gpt-4o*, שמקטין כל תמונה ל-768px)
# GPT_IMAGE_SPLIT=1

# "חשיבה" של Gemini (אם יופעל): -1 = הוא מחליט לבד כמה, בלי תקרה; 0 = כבויה.
GEMINI_THINKING_BUDGET=-1

# ---- "דיו מודגש" ----
# 1 = נשלחת למודל גם גרסה בלי מרקרים, שבה כתב היד שחור (תמונה שנייה — עולה כסף).
# 0 = כבוי (ברירת מחדל). המתג "דיו מודגש" במסך עובד תמיד — הוא מקומי ובחינם.
ENHANCE_INK=0

# ---- יישור דף ----
# דף עקום (2° ומעלה) או על הצד מיושר מקומית לפני הקריאה. בחינם, בלי מודל.
# דף הפוך (180°) מזוהה על ידי המודל באותה קריאה, ומסובב לתצוגה בלבד.
# 1 = פעיל, 0 = כבוי.
STRAIGHTEN_PAGES=1

# ---- תקציב ----
# רשת ביטחון נגד תקלה: העלאה שתעבור את הסכום תיעצר לפני הקריאה הבאה, עם הודעה.
# 0 = בלי תקרה.
MAX_COST_PER_BATCH_USD=10.00

# ---- איכות קלט ----
# תמונה שהצד הארוך שלה קצר מזה — אזהרת רזולוציה נמוכה (צילום מסך)
MIN_IMAGE_LONG_SIDE=1500
PAGE_RENDER_DPI=300

# ---- היקף ----
MAX_PAGES_PER_BATCH=30
MAX_FILES_PER_BATCH=25
# חשיבה עמוקה איטית — לכן כמה טפסים נקראים במקביל
MAX_PARALLEL_CALLS=6
MAX_UPLOAD_BYTES=41943040
