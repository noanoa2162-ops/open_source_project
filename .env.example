# העתיקו לקובץ בשם .env ומלאו שם את הערכים. אין לכתוב כאן מפתחות.
# .env מוחרג ב-.gitignore.
# כל הגדרה שלא כתובה ב-.env מקבלת את ברירת המחדל שמופיעה כאן.

# ---- מפתח ----
# Claude — מפתח מ-console.anthropic.com
ANTHROPIC_API_KEY=

# ---- הקורא ----
# מודל אחד חזק קורא כל טופס לבד. מה שהוא לא בטוח בו — כתום.
# הבדיקות המקומיות (ת"ז, תאריכים, גורם שולח ועוד) רצות תמיד, בחינם.
READER_MODEL=claude-opus-5-5
# עומק החשיבה: low | medium | high | xhigh | max.
# ב-Opus 5.5 החשיבה תמיד פועלת; זה קובע כמה עמוק. עמוק יותר = יקר ואיטי יותר.
READER_EFFORT=high
# (השמות הישנים JUDGE_A_MODEL ו-JUDGE_EFFORT עדיין נקראים)

# ---- סיבוב אוטומטי (Tesseract) ----
# דף שנסרק על הצד (90°/270°) או הפוך (180°) מזוהה ומסובב לפני הקריאה. מקומי, בחינם.
# נמדד על 48 עמודי הדוגמה: 11/11 דפים מסובבים תוקנו, 0/37 דפים ישרים נגעו.
# אם Tesseract לא מותקן — השלב מדולג. 1 = פעיל, 0 = כבוי.
AUTO_ROTATE=1
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ---- יישור דף ----
# דף עקום (2° ומעלה) מיושר מקומית לפני הקריאה. בחינם, בלי מודל.
# 1 = פעיל, 0 = כבוי.
STRAIGHTEN_PAGES=1

# ---- תקציב ----
# רשת ביטחון נגד תקלה: העלאה שתעבור את הסכום תיעצר לפני הקריאה הבאה, עם הודעה.
# 0 = בלי תקרה.
MAX_COST_PER_BATCH_USD=10.00

# ---- איכות קלט ----
# תמונה שהצד הארוך שלה קצר מזה — אזהרת רזולוציה נמוכה (צילום מסך)
MIN_IMAGE_LONG_SIDE=1500
PAGE_RENDER_DPI=300

# ---- היקף ----
MAX_PAGES_PER_BATCH=30
MAX_FILES_PER_BATCH=25
# חשיבה עמוקה איטית — לכן כמה טפסים נקראים במקביל.
# 10 = צעד זהיר (ברירת המחדל בקוד: 6). משנה רק את הקצב, לא את המחיר לטופס.
# מגבלת הקצב של החשבון ב-Anthropic לא ידועה: אם מופיעות שגיאות "rate limit" — להוריד.
MAX_PARALLEL_CALLS=10
MAX_UPLOAD_BYTES=41943040

# ---- מיתוג המסך ----
# moh = עיצוב משרד הבריאות (לוגו, צבעים, כותרות); neutral = הסמל והשם שלנו
BRAND=moh
